# =============================================================================
# AI 闯关学习 · 后端环境变量示例
# =============================================================================
# 使用方式：
#   cp .env.example .env
#   然后编辑 .env，填入真实配置（.env 已被 .gitignore 忽略，勿提交）
# =============================================================================

# -----------------------------------------------------------------------------
# DeepSeek / LLM
# -----------------------------------------------------------------------------
# 在 https://platform.deepseek.com 申请 API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# 服务
# -----------------------------------------------------------------------------
# 跨域来源，开发期可用 *；生产环境建议改为具体域名
CORS_ORIGINS=*

# V1 匿名会话本地兜底文件路径（内存为主）
SESSION_FILE_PATH=./data/sessions.json

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
# 应用运行时连接（asyncmy 异步驱动）
# 格式：mysql+asyncmy://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+asyncmy://root:your_mysql_password@127.0.0.1:3306/w_ai_learn?charset=utf8mb4

# 是否打印 SQL 日志，调试时可设为 true
DATABASE_ECHO=false

# 数据库初始化脚本 scripts/init_database.py 专用（同步 pymysql，用于建库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=w_ai_learn

# -----------------------------------------------------------------------------
# 微信小程序
# -----------------------------------------------------------------------------
# 在微信公众平台 → 开发 → 开发管理 → 开发设置 中获取
# AppID：小程序 ID
# AppSecret：小程序密钥（仅保存在服务端 .env，切勿写入前端或提交 Git）
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# 开发调试：true 时跳过微信 API，用 mock openid（生产环境必须为 false）
WECHAT_MOCK_LOGIN=false

# -----------------------------------------------------------------------------
# JWT（用户登录态）
# -----------------------------------------------------------------------------
# 用于签发与校验登录 Token；生产环境请使用足够长的随机字符串
JWT_SECRET=your_random_jwt_secret_at_least_32_chars
JWT_EXPIRE_DAYS=7
